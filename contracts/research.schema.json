{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded research provenance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "license",
    "collection_method",
    "technical_category",
    "resource_type",
    "url",
    "observed_at",
    "restrictions",
    "content_sha256",
    "level",
    "deduplication",
    "evidence",
    "rubric",
    "evaluation_result",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "collection_method": {
      "type": "string",
      "minLength": 1
    },
    "technical_category": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "enum": [
        "web_page",
        "android_application",
        "desktop_program",
        "web_application",
        "agent_skill",
        "prompt",
        "technical_document"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "deduplication": {
      "enum": [
        "unprocessed",
        "unique",
        "duplicate"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "outcome"
        ],
        "properties": {
          "kind": {
            "enum": [
              "provenance",
              "content",
              "execution",
              "comparison"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "observed",
              "passed",
              "failed",
              "improved",
              "no_improvement"
            ]
          },
          "inspected": {
            "type": "boolean"
          },
          "authorized": {
            "type": "boolean"
          },
          "independent": {
            "type": "boolean"
          },
          "matched_conditions": {
            "type": "boolean"
          }
        }
      }
    },
    "rubric": {
      "type": "object"
    },
    "evaluation_result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
