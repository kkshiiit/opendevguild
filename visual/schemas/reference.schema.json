{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Intelligence inspected reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "platform",
    "context",
    "provenance",
    "license",
    "visual_reference",
    "composition",
    "typography",
    "color",
    "geometry",
    "materials",
    "movement",
    "accessibility",
    "strengths",
    "weaknesses",
    "antipatterns",
    "evaluation_rationale"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "author",
        "source_path",
        "source_sha256",
        "date"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original",
            "licensed"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "redistribution_allowed",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "inspected",
        "inspection"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inspected": {
          "type": "boolean"
        },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer_kind",
            "date",
            "method",
            "observations"
          ],
          "properties": {
            "reviewer_kind": {
              "enum": [
                "agent",
                "human"
              ]
            },
            "date": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "composition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "typography": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "color": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "movement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accessibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weaknesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "antipatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation_rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
